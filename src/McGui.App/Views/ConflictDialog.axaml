<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:McGui.App.ViewModels"
        mc:Ignorable="d"
        x:Class="McGui.App.Views.ConflictDialog"
        x:DataType="vm:ConflictDialogViewModel"
        Width="420" SizeToContent="Height"
        Title="Name conflict"
        WindowStartupLocation="CenterOwner">
  <StackPanel Margin="16" Spacing="12">
    <TextBlock Text="An entry with this name already exists:" TextWrapping="Wrap" />
    <TextBlock Text="{Binding DestinationPath}" FontWeight="Bold" TextWrapping="Wrap" />
    <CheckBox Content="Apply to all remaining conflicts" IsChecked="{Binding ApplyToAll}" />
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
      <Button Content="Abort" Command="{Binding AbortCommand}" />
      <Button Content="Skip" Command="{Binding SkipCommand}" />
      <Button Content="Rename" Command="{Binding RenameCommand}" />
      <Button Content="Overwrite" Command="{Binding OverwriteCommand}" IsDefault="True" />
    </StackPanel>
  </StackPanel>
</Window>
