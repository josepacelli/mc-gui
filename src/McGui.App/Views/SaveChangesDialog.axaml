<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:McGui.App.ViewModels"
        x:Class="McGui.App.Views.SaveChangesDialog"
        x:DataType="vm:SaveChangesDialogViewModel"
        Width="400" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        Title="Unsaved changes">
  <StackPanel Margin="16" Spacing="12">
    <TextBlock Text="{Binding Message}" TextWrapping="Wrap" />
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
      <Button Content="Cancel" Command="{Binding CancelCommand}" />
      <Button Content="Don't Save" Command="{Binding DiscardCommand}" />
      <Button Content="Save" Command="{Binding SaveCommand}" IsDefault="True" />
    </StackPanel>
  </StackPanel>
</Window>