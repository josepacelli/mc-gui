<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:McGui.App.ViewModels"
        xmlns:AvaloniaEdit="clr-namespace:AvaloniaEdit;assembly=AvaloniaEdit"
        mc:Ignorable="d"
        x:Class="McGui.App.Views.EditorWindow"
        x:DataType="vm:EditorWindowViewModel"
        Width="1000" Height="700"
        MinWidth="640" MinHeight="400"
        Title="Editor"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource ThemeBackgroundBrush}">

  <Window.Styles>
    <Style Selector="Button.fkey">
      <Setter Property="Background" Value="{DynamicResource NativeToolbarBackgroundBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource NativeToolbarButtonForegroundBrush}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="6,3" />
      <Setter Property="FontSize" Value="11" />
    </Style>
  </Window.Styles>

  <DockPanel>
    <!-- Toolbar F1-F10 -->
    <Border DockPanel.Dock="Top"
            Background="{DynamicResource NativeToolbarBackgroundBrush}"
            BorderBrush="{DynamicResource NativeToolbarBorderBrush}"
            BorderThickness="0,0,0,1"
            Padding="4">
      <StackPanel Orientation="Horizontal" Spacing="4">
        <Button Classes="fkey" Content="F1 Help" Click="OnHelpClick" />
        <Button Classes="fkey" Content="F2 Save" Click="OnSaveClick" />
        <Button Classes="fkey" Content="F3 Find" Click="OnFindClick" />
        <Button Classes="fkey" Content="F4 Replace" Click="OnReplaceClick" />
        <Button Classes="fkey" Content="F5 Macro" IsEnabled="False" />
        <Button Classes="fkey" Content="F6 Block" IsEnabled="False" />
        <Button Classes="fkey" Content="F7 Spell" IsEnabled="False" />
        <Button Classes="fkey" Content="F8 Config" IsEnabled="False" />
        <Button Classes="fkey" Content="F9 Menu" IsEnabled="False" />
        <Button Classes="fkey" Content="F10 Quit" Click="OnQuitClick" />
      </StackPanel>
    </Border>

    <!-- Search / Replace bar -->
    <Border DockPanel.Dock="Top"
            Background="{DynamicResource SearchBarBackgroundBrush}"
            BorderBrush="{DynamicResource SearchBarBorderBrush}"
            BorderThickness="0,0,0,1"
            Padding="8,4"
            x:Name="SearchBar"
            IsVisible="False">
      <StackPanel Spacing="6">
        <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8">
          <TextBlock Text="Find:" VerticalAlignment="Center" />
          <TextBox Grid.Column="1" x:Name="SearchTextBox" KeyDown="OnSearchKeyDown" />
          <Button Grid.Column="2" Content="Prev" Click="OnSearchPrevClick" />
          <Button Grid.Column="3" Content="Next" Click="OnSearchNextClick" />
        </Grid>
        <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8">
          <TextBlock Text="Replace with:" VerticalAlignment="Center" />
          <TextBox Grid.Column="1" x:Name="ReplaceTextBox" />
          <Button Grid.Column="2" Content="Replace" Click="OnReplaceClick2" />
          <Button Grid.Column="3" Content="Replace All" Click="OnReplaceAllClick" />
        </Grid>
        <StackPanel Orientation="Horizontal" Spacing="12">
          <CheckBox Content="Regex" x:Name="RegexToggle" />
          <CheckBox Content="Match case" x:Name="CaseToggle" />
          <CheckBox Content="Whole word" x:Name="WholeWordToggle" />
          <TextBlock x:Name="SearchStatus" VerticalAlignment="Center" Foreground="{DynamicResource TextMutedBrush}" />
        </StackPanel>
      </StackPanel>
    </Border>

    <!-- Tabs of editors -->
    <TabControl x:Name="EditorTabs"
                Background="{DynamicResource ViewerBackgroundBrush}"
                BorderThickness="0">
      <TabControl.Styles>
        <Style Selector="TabItem">
          <Setter Property="Padding" Value="8,3" />
        </Style>
      </TabControl.Styles>
    </TabControl>

    <!-- Status bar -->
    <Border DockPanel.Dock="Bottom"
            Background="{DynamicResource StatusBarBackgroundBrush}"
            BorderBrush="{DynamicResource StatusBarBorderBrush}"
            BorderThickness="0,1,0,0"
            Padding="8,3">
      <StackPanel Orientation="Horizontal" Spacing="16">
        <TextBlock x:Name="StatusEncoding" Foreground="{DynamicResource TextMutedBrush}" />
        <TextBlock x:Name="StatusReadOnly" Foreground="{DynamicResource TextWarningBrush}" />
        <TextBlock x:Name="StatusPosition" Foreground="{DynamicResource TextMutedBrush}" />
      </StackPanel>
    </Border>
  </DockPanel>
</Window>