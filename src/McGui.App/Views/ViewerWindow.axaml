<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:McGui.App.ViewModels"
        xmlns:views="using:McGui.App.Views"
        mc:Ignorable="d"
        x:Class="McGui.App.Views.ViewerWindow"
        x:DataType="vm:ViewerViewModel"
        Width="900" Height="600"
        MinWidth="600" MinHeight="400"
        Title="{Binding Title, StringFormat='Viewer - {0}'}"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource ThemeBackgroundBrush}">

  <Window.Styles>
    <Style Selector="Button.fkey">
      <Setter Property="Background" Value="{DynamicResource NativeToolbarBackgroundBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource NativeToolbarButtonForegroundBrush}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="8,4" />
      <Setter Property="FontFamily" Value="{DynamicResource MonospaceFontFamily}" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.fkey:pointerover">
      <Setter Property="Background" Value="{DynamicResource NativeToolbarButtonHoverBackgroundBrush}" />
    </Style>
    <Style Selector="Button.fkey:pressed">
      <Setter Property="Background" Value="{DynamicResource NativeToolbarButtonPressedBackgroundBrush}" />
    </Style>
  </Window.Styles>

  <DockPanel>
    <!-- Toolbar F1-F10 -->
    <Border DockPanel.Dock="Top"
            Background="{DynamicResource NativeToolbarBackgroundBrush}"
            BorderBrush="{DynamicResource NativeToolbarBorderBrush}"
            BorderThickness="0,0,0,1"
            Padding="4">
      <StackPanel Orientation="Horizontal" Spacing="4">
        <Button Classes="fkey" Content="F1 Help" Command="{Binding HelpCommand}" ToolTip.Tip="Help (F1)" />
        <Button Classes="fkey" Content="F2 Wrap" Command="{Binding ToggleWrapCommand}" ToolTip.Tip="Toggle Word Wrap (F2)" />
        <Button Classes="fkey" Content="F3 Prev" Command="{Binding PreviousMatchCommand}" ToolTip.Tip="Previous Match (Shift+F3)" IsVisible="{Binding HasSearchResults}" />
        <Button Classes="fkey" Content="F4 Hex" Command="{Binding ToggleHexCommand}" ToolTip.Tip="Toggle Hex/Ascii (F4)" />
        <Button Classes="fkey" Content="F5 Reload" Command="{Binding ReloadCommand}" ToolTip.Tip="Reload (F5)" />
        <Button Classes="fkey" Content="F6 Next" Command="{Binding NextMatchCommand}" ToolTip.Tip="Next Match (F3)" IsVisible="{Binding HasSearchResults}" />
        <Button Classes="fkey" Content="F7 Search" Command="{Binding SearchCommand}" ToolTip.Tip="Search (F7/Ctrl+F)" />
        <Button Classes="fkey" Content="F8" ToolTip.Tip="Reserved" IsEnabled="False" />
        <Button Classes="fkey" Content="F9 Menu" ToolTip.Tip="Menu (F9)" IsEnabled="False" />
        <Button Classes="fkey" Content="F10 Quit" Command="{Binding CloseCommand}" ToolTip.Tip="Quit (F10/Esc)" />
      </StackPanel>
    </Border>

    <!-- Search Bar -->
    <Border DockPanel.Dock="Top"
            Background="{DynamicResource SearchBarBackgroundBrush}"
            BorderBrush="{DynamicResource SearchBarBorderBrush}"
            BorderThickness="0,0,0,1"
            Padding="8,4"
            IsVisible="{Binding IsSearchVisible}">
      <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto" ColumnSpacing="8">
        <TextBlock Text="Search:" VerticalAlignment="Center" Foreground="{DynamicResource TextForegroundBrush}" />
        <TextBox Grid.Column="1"
                 x:Name="SearchTextBox"
                 Text="{Binding SearchQuery, Mode=TwoWay}"
                 Watermark="Search (Ctrl+F)..."
                 VerticalAlignment="Center"
                 KeyDown="OnSearchKeyDown" />
        <TextBlock Grid.Column="2"
                   Text="{Binding SearchMatchInfo}"
                   VerticalAlignment="Center"
                   Foreground="{DynamicResource TextMutedBrush}"
                   IsVisible="{Binding HasSearchResults}" />
        <Button Grid.Column="3"
                Content="Prev"
                Command="{Binding PreviousMatchCommand}"
                IsVisible="{Binding HasSearchResults}"
                ToolTip.Tip="Previous Match (Shift+F3)" />
        <Button Grid.Column="4"
                Content="Next"
                Command="{Binding NextMatchCommand}"
                IsVisible="{Binding HasSearchResults}"
                ToolTip.Tip="Next Match (F3)" />
        <Button Grid.Column="4"
                Content="Close"
                Command="{Binding CloseSearchCommand}"
                IsVisible="{Binding IsSearchVisible}"
                ToolTip.Tip="Close Search (Esc)" />
      </Grid>
    </Border>

    <!-- Content Area -->
    <ScrollViewer x:Name="ContentScrollViewer"
                  HorizontalScrollBarVisibility="Auto"
                  VerticalScrollBarVisibility="Auto"
                  Background="{DynamicResource ViewerBackgroundBrush}">
      <ContentControl x:Name="ContentPresenter" Content="{Binding Mode, Converter={StaticResource ModeToContentConverter}}" />
    </ScrollViewer>

    <!-- Status Bar -->
    <Border DockPanel.Dock="Bottom"
            Background="{DynamicResource StatusBarBackgroundBrush}"
            BorderBrush="{DynamicResource StatusBarBorderBrush}"
            BorderThickness="0,1,0,0"
            Padding="8,4">
      <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16">
        <TextBlock Text="{Binding FilePath}"
                   VerticalAlignment="Center"
                   Foreground="{DynamicResource TextForegroundBrush}"
                   TextTrimming="CharacterEllipsis"
                   MaxWidth="400" />
        <TextBlock Grid.Column="1"
                   Text="{Binding StatusMessage}"
                   VerticalAlignment="Center"
                   HorizontalAlignment="Center"
                   Foreground="{DynamicResource TextMutedBrush}" />
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
          <TextBlock Text="{Binding Mode, StringFormat='Mode: {0}'}"
                     VerticalAlignment="Center"
                     Foreground="{DynamicResource TextForegroundBrush}" />
          <TextBlock Text="{Binding Encoding, StringFormat='Encoding: {0}'}"
                     VerticalAlignment="Center"
                     Foreground="{DynamicResource TextMutedBrush}" />
          <TextBlock Text="{Binding FileSize, StringFormat='Size: {0} bytes'}"
                     VerticalAlignment="Center"
                     Foreground="{DynamicResource TextMutedBrush}" />
          <TextBlock Text="{Binding ScrollOffset, StringFormat='Line: {0}'}"
                     VerticalAlignment="Center"
                     Foreground="{DynamicResource TextMutedBrush}" />
        </StackPanel>
      </Grid>
    </Border>
  </DockPanel>
</Window>