<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:McGui.App.ViewModels"
             mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="300"
             x:Class="McGui.App.Views.PanelView"
             x:DataType="vm:PanelViewModel">
  <UserControl.Styles>
    <Style Selector="Border.panelRoot">
      <Setter Property="BorderBrush" Value="{DynamicResource PanelBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Border.panelRoot.active">
      <Setter Property="BorderBrush" Value="{DynamicResource PanelBorderActiveBrush}" />
      <Setter Property="BorderThickness" Value="2" />
    </Style>
  </UserControl.Styles>

  <Border Classes="panelRoot" Classes.active="{Binding IsActive}">
    <Grid RowDefinitions="Auto,*,Auto,Auto">
      <TextBlock Grid.Row="0" Text="{Binding CurrentDirectory}" FontWeight="Bold" Margin="4" />

      <Grid Grid.Row="1">
        <ListBox ItemsSource="{Binding DisplayEntries}"
                 SelectedIndex="{Binding CursorIndex, Mode=OneWay}"
                 SelectionChanged="OnListSelectionChanged"
                 DoubleTapped="OnListDoubleTapped"
                 Focusable="False">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:PanelEntryRow">
              <Grid ColumnDefinitions="Auto,Auto,*,Auto">
                <PathIcon Grid.Column="0" Width="14" Height="14" IsVisible="{Binding IsFolder}" Foreground="{DynamicResource FolderIconBrush}" Data="M10,4 L4,4 C2.9,4 2.01,4.9 2.01,6 L2,14 C2,15.1 2.9,16 4,16 L16,16 C17.1,16 18,15.1 18,14 L18,8 C18,6.9 17.1,6 16,6 L11,6 L10,4 Z" />
                <PathIcon Grid.Column="0" Width="14" Height="14" IsVisible="{Binding IsFile}" Foreground="{DynamicResource FileIconBrush}" Data="M14,2 L6,2 C4.9,2 4,2.9 4,4 L4,16 C4,17.1 4.9,18 6,18 L14,18 C15.1,18 16,17.1 16,16 L16,4 C16,2.9 15.1,2 14,2 Z M13,12 L7,12 L7,10 L13,10 L13,12 Z M13,8 L7,8 L7,6 L13,6 L13,8 Z" />
                <TextBlock Grid.Column="1" Text="*" IsVisible="{Binding IsMarked}" Width="14" />
                <TextBlock Grid.Column="2" Text="{Binding DisplayName}" />
                <TextBlock Grid.Column="3" Text="{Binding SizeText}" Margin="8,0,0,0" />
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>

        <Border Background="{DynamicResource OverlayLoadingBackgroundBrush}" IsVisible="{Binding IsLoading}">
          <TextBlock Text="Loading..." Foreground="{DynamicResource OverlayLoadingForegroundBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>

        <Border Background="{DynamicResource OverlayErrorBackgroundBrush}" IsVisible="{Binding IsDirectoryInaccessible}">
          <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
            <TextBlock Text="{Binding DirectoryErrorMessage}" Foreground="{DynamicResource OverlayErrorForegroundBrush}" HorizontalAlignment="Center" TextWrapping="Wrap" />
            <Button Content="Go to home directory" Command="{Binding GoToHomeCommand}" HorizontalAlignment="Center" />
          </StackPanel>
        </Border>
      </Grid>

      <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="4" Spacing="12">
        <TextBlock Text="{Binding MarkedCount, StringFormat='Marked: {0}'}" />
        <TextBlock Text="{Binding MarkedSizeBytes, StringFormat='({0} bytes)'}" />
      </StackPanel>
    </Grid>
  </Border>
</UserControl>
